# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/bookleaf

# Frontend origin for CORS (no trailing slash)
CLIENT_URL=http://localhost:3000

# JWT authentication
JWT_SECRET=replace-with-a-secure-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
JWT_ISSUER=bookleaf-api
JWT_AUDIENCE=bookleaf-portal

# Cookie settings
COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/

# Login protection
LOGIN_RATE_LIMIT_MAX=10

# Database seeding (local development only)
# Required to run `npm run seed`
SEED_CONFIRM=yes
# Database seeding / local admin
SEED_AUTHOR_DEFAULT_PASSWORD=Author@123
ADMIN_EMAIL=admin@bookleaf.com
ADMIN_PASSWORD=Admin@123

# AI provider (openai | ollama — omit AI_PROVIDER to disable)
AI_PROVIDER=openai
OPENAI_API_KEY=<open-api-key>
OPENAI_MODEL=gpt-4o-mini

# Ollama alternative (when AI_PROVIDER=ollama)
# AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=your-installed-model
